# Environment variables for the Nuren Group website (server.js on Railway).
#
# Production values live in Railway: service nuren-group-website → Variables.
# Changing a variable there redeploys the service. Nothing in this repo loads a
# .env file automatically, so to run `npm start` locally, export these in your
# shell first. Never commit real keys: .env* is git-ignored, this file is not.

# ── Required ─────────────────────────────────────────────────────────────────

# ANTHROPIC_API_KEY: secret. Powers the Nura chatbot (/api/chat, /api/chat/brief).
# Calls are server-side only; the browser never sees this key.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="MY_ANTHROPIC_API_KEY"

# RESEND_API_KEY: secret. Sends every enquiry email (Contact Us + chat form).
# Get one at https://resend.com. If unset, enquiries are written to the server
# log instead of emailed (they are still saved to the Leads tab).
RESEND_API_KEY=""

# SUPERADMIN_PASSWORD: secret. Basic Auth password for /admin (any username).
# Use a long random passphrase (15+ characters). If unset or left as the
# placeholder below, /admin returns "Admin access unavailable".
SUPERADMIN_PASSWORD="set-me-in-dashboard"

# ── Enquiry email ────────────────────────────────────────────────────────────

# ENQUIRY_FROM_EMAIL: sender shown on enquiry emails. The domain must be
# verified in Resend. Production sends from Motherhood's address, matching
# Motherhood's own contact form (motherhood.com.my verified in Resend,
# Tokyo region, 2026-10-06).
# If unset, falls back to Resend's sandbox sender, which only delivers to the
# Resend account owner.
ENQUIRY_FROM_EMAIL="Nuren Group Website <hi@motherhood.com.my>"

# ENQUIRY_RECIPIENT: who receives each enquiry. Defaults to Petrina if unset.
ENQUIRY_RECIPIENT="petrina.goh@nurengroup.com"

# ENQUIRY_CC: optional, comma-separated extra recipients (e.g. the sales team).
ENQUIRY_CC=""

# ── Lead storage ─────────────────────────────────────────────────────────────

# LEADS_DIR: where leads.jsonl and uploaded briefs are saved. Holds full contact
# details, so it is a PDPA data store behind admin auth.
# Production: the Railway volume "nuren-leads" is mounted at /data, so this is
# /data/leads. Leads only survive redeploys while it points at that volume.
# Locally, leave unset to use ./data (git-ignored).
LEADS_DIR="/data/leads"

# ── Chatbot model (optional) ─────────────────────────────────────────────────

# NURA_MODEL: which Claude model Nura uses, by key (see server/nura/model.js):
#   haiku  → Claude Haiku 4.5 (default; fastest, cheapest)
#   sonnet → Claude Sonnet 5 (better at natural BM/Mandarin; ~2x per token)
# Compare them with `npm run eval:nura` before switching production.
NURA_MODEL="haiku"

# NURA_EFFORT: reasoning effort, sonnet only (Haiku ignores it):
# low | medium | high | xhigh | max. Chat rarely needs more than low.
NURA_EFFORT="low"

# ── Runtime (optional) ───────────────────────────────────────────────────────

# PORT: Railway sets this itself. Defaults to 3000 locally.
PORT="3000"

# APP_URL: public URL of the site. Set in Railway for reference only; no code
# reads it today.
APP_URL="https://nuren-group-website-production.up.railway.app"

# DISABLE_HMR: dev only. Set to "true" to turn off Vite hot reload.
DISABLE_HMR=""
